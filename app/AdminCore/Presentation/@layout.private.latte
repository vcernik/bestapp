{layout '@layout.base.latte'}

{block body}
	<div class="min-vh-100 d-flex flex-column">
		<div class="container-fluid px-0" style="flex: 1 1 auto;">
			<div class="d-flex d-lg-none justify-content-between align-items-center border-bottom bg-light px-3 py-2">
				<a n:href=":Admin:Home:default" class="d-flex align-items-center link-dark text-decoration-none">
					<i class="fa-solid fa-shield-halved fs-4 me-2"></i>
					<span class="fs-5">{$appName ?? 'Administrace'}</span>
				</a>
				<button id="adminSidebarToggle" class="btn btn-outline-secondary d-lg-none" type="button" aria-controls="adminSidebarMenu" aria-expanded="false" aria-label="Přepnout navigační menu">
					<i class="fa-solid fa-bars" aria-hidden="true"></i>
				</button>
			</div>
			<div class="row g-0 min-vh-lg-100">
				<aside id="adminSidebarMenu" class="admin-sidebar collapse col-12 col-lg-3 col-xl-2 border-end bg-light d-lg-flex flex-column p-3">
					<a n:href=":Admin:Home:default" class="d-none d-lg-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
						<i class="fa-solid fa-shield-halved fs-4 me-2"></i>
						<span class="fs-5">{$appName ?? 'Administrace'}</span>
					</a>
					<hr class="d-none d-lg-block">

					<ul class="nav nav-pills flex-column mb-lg-2" aria-label="Hlavní menu administrace">
						<li n:foreach="$adminMenuItems as $item" class="nav-item">
							{if isset($item['items'])}
								{var $hasActiveChild = false}
								{foreach $item['items'] as $child}
									{var $childParams = $child['params'] ?? []}
									{var $childPresenterDestination = isset($child['destination']) ? preg_replace('~:[^:]+$~', ':*', $child['destination']) : null}
									{var $isChildCurrent = isset($child['destination']) && ($presenter->isLinkCurrent($child['destination'], $childParams) || ($childPresenterDestination !== null && $presenter->isLinkCurrent($childPresenterDestination, $childParams)))}
									{if $isChildCurrent}
										{var $hasActiveChild = true}
									{/if}
								{/foreach}
								{var $isCollapsible = $item['collapsible'] ?? false}
								{if $isCollapsible}
									{var $collapseId = 'adminMenuCollapse-' . $iterator->counter}
									<button type="button" class="nav-link w-100 border-0 bg-transparent text-start d-flex align-items-center justify-content-between {$hasActiveChild ? 'active' : 'text-secondary fw-semibold'}" data-bs-toggle="collapse" data-bs-target="#{$collapseId}" aria-controls="{$collapseId}" aria-expanded="{$hasActiveChild ? 'true' : 'false'}">
										<span>{$item['name']}</span>
										<i class="fa-solid fa-chevron-down small ms-2" aria-hidden="true"></i>
									</button>
									<div id="{$collapseId}" class="collapse {if $hasActiveChild}show{/if}">
										<ul class="nav nav-pills flex-column ms-3 mb-2" aria-label="Podmenu {$item['name']}">
											<li n:foreach="$item['items'] as $child" class="nav-item">
												{var $childParams = $child['params'] ?? []}
												{var $childPresenterDestination = isset($child['destination']) ? preg_replace('~:[^:]+$~', ':*', $child['destination']) : null}
												{var $isChildCurrent = isset($child['destination']) && ($presenter->isLinkCurrent($child['destination'], $childParams) || ($childPresenterDestination !== null && $presenter->isLinkCurrent($childPresenterDestination, $childParams)))}
												<a n:if="isset($child['destination'])" n:href="$child['destination'], ...$childParams" class="nav-link py-1 {$isChildCurrent ? 'active' : 'link-dark'}" aria-current="{$isChildCurrent ? 'page' : null}">
													{$child['name']}
												</a>
												<span n:if="!isset($child['destination'])" class="nav-link py-1 link-secondary">{$child['name']}</span>
											</li>
										</ul>
									</div>
								{else}
									<div class="nav-link text-secondary fw-semibold">{$item['name']}</div>
									<ul class="nav nav-pills flex-column ms-3 mb-2" aria-label="Podmenu {$item['name']}">
										<li n:foreach="$item['items'] as $child" class="nav-item">
											{var $childParams = $child['params'] ?? []}
											{var $childPresenterDestination = isset($child['destination']) ? preg_replace('~:[^:]+$~', ':*', $child['destination']) : null}
											{var $isChildCurrent = isset($child['destination']) && ($presenter->isLinkCurrent($child['destination'], $childParams) || ($childPresenterDestination !== null && $presenter->isLinkCurrent($childPresenterDestination, $childParams)))}
											<a n:if="isset($child['destination'])" n:href="$child['destination'], ...$childParams" class="nav-link py-1 {$isChildCurrent ? 'active' : 'link-dark'}" aria-current="{$isChildCurrent ? 'page' : null}">
												{$child['name']}
											</a>
											<span n:if="!isset($child['destination'])" class="nav-link py-1 link-secondary">{$child['name']}</span>
										</li>
									</ul>
								{/if}
							{else}
								{var $itemParams = $item['params'] ?? []}
								{var $itemPresenterDestination = isset($item['destination']) ? preg_replace('~:[^:]+$~', ':*', $item['destination']) : null}
								{var $isItemCurrent = isset($item['destination']) && ($presenter->isLinkCurrent($item['destination'], $itemParams) || ($itemPresenterDestination !== null && $presenter->isLinkCurrent($itemPresenterDestination, $itemParams)))}
								<a n:if="isset($item['destination'])" n:href="$item['destination'], ...$itemParams" class="nav-link {$isItemCurrent ? 'active' : 'link-dark'}" aria-current="{$isItemCurrent ? 'page' : null}">
									{$item['name']}
								</a>
							{/if}
						</li>
					</ul>

					<hr>
					<div class="dropdown">
						<a href="#" class="d-flex align-items-center link-dark text-decoration-none dropdown-toggle" id="adminSidebarUser" data-bs-toggle="dropdown" aria-expanded="false">
							<i class="fa-solid fa-user-circle fs-4 me-2" aria-hidden="true"></i>
							{$currentUser->name ?? $currentUser->username ?? 'Správce'}
						</a>
						<ul class="dropdown-menu text-small shadow" aria-labelledby="adminSidebarUser">
							<li><a class="dropdown-item" n:href=":AdminCore:Profile:default">Změna hesla</a></li>
							<li><a class="dropdown-item text-danger" n:href=":AdminCore:Public:Sign:out">Odhlásit</a></li>
						</ul>
					</div>
				</aside>

				<main class="col-12 col-lg-9 col-xl-10 p-3 p-md-4 p-xl-5 py-xl-4 bg-white">
					{block breadcrumbs}
					<nav aria-label="breadcrumb" class="mb-3">
						<ol class="breadcrumb mb-0 small">
							<li n:foreach="$breadcrumbs as $item" class="breadcrumb-item {if $iterator->isLast()}active{/if}" aria-current="{if $iterator->isLast()}page{/if}" >
								{if $item['link'] !== null && !$iterator->isLast()}
									<a n:href="$item['link']" class="text-decoration-none">{$item['title']}</a>
								{else}
									{$item['title']}
								{/if}
							</li>
						</ol>
					</nav>
					{/block}
					<div class="my-3">
						{snippet flashes}
							<div n:foreach="$flashes as $flash" class="alert alert-{$flash->type ?: 'info'} mb-2" role="alert">{$flash->message}</div>
						{/snippet}
					</div>
					{if isset($pageTitle)}
						<h3 class="h3 my-4" n:block="title">{$pageTitle}</h3>
					{/if}
					{include content}
				</main>
			</div>
		</div>
	</div>
{/block}
